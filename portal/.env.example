# Neon'un havuzlanmış bağlantı adresi. Yalnız sunucuda kullanılır.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Console > Auth bölümündeki proje adresi.
NEON_AUTH_BASE_URL=https://HOST.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# En az 32 karakterlik, yalnız sunucuda tutulan rastgele değer.
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Şifre yenileme bağlantılarının döneceği uygulama adresi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kullanıcı PIN'lerini (cihaz değiştirme) şifrelemek için — en az 32 rastgele karakter.
PIN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# /api/admin/flagged-questions ucunu korur — günlük işaretli-soru bakım akışı bu token'ı
# Authorization: Bearer <token> olarak gönderir. DATABASE_URL'i asla açığa çıkarmaz.
FLAGS_EXPORT_TOKEN=replace-with-a-random-token
